# =============================================================================
# BANCO DE DADOS - PostgreSQL
# =============================================================================
POSTGRES_USER=
POSTGRES_PASSWORD=

# Base da URL JDBC — o sufixo do banco (db_usuario, db_escola, etc.) é
# concatenado diretamente no docker-compose para cada serviço.
# Quando rodando via Docker Compose o host é o nome do service "postgres"
# (porta interna 5432). Para rodar localmente use localhost:5433.
SPRING_DATASOURCE_URL=jdbc:postgresql://<HOST>:5432/
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# =============================================================================
# EUREKA — Service Discovery
# =============================================================================
# ATENÇÃO: este valor muda dependendo do contexto de execução:
#
#   → Rodando via Docker Compose:
#       EUREKA_URL=http://aspmanager-service-discovery:8761/eureka/
#
#   → Rodando localmente (fora do Docker):
#       EUREKA_URL=http://localhost:8761/eureka/
#
# O gateway (aspmanager-gateway) e todos os outros serviços usam esta mesma
# variável. Certifique-se de ajustá-la conforme o ambiente.
EUREKA_URL=

# =============================================================================
# JWT — Auth Service
# =============================================================================
JWT_SECRET=
